# DiveBlendr Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# Every variable here is OPTIONAL. They configure analytics and search-engine
# verification only. The app — every calculator, the blender, and the dive
# planner — works fully with all of them blank. If you are contributing to the
# calculation code, you do not need any of these.

# Google Analytics 4 measurement ID.
# Leave blank to disable Google Analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GoatCounter analytics domain (your account subdomain).
# Example: mysite.goatcounter.com — leave blank to disable GoatCounter.
NEXT_PUBLIC_GOATCOUNTER_DOMAIN=

# Google Search Console site-verification token.
# Only needed if you deploy your own instance and want to verify ownership.
GOOGLE_SITE_VERIFICATION=
